# ShelfSense Environment Configuration Example
# Copy to .env and replace all placeholder secrets before running. Never commit .env.

# PostgreSQL
POSTGRES_DB=shelfsense
POSTGRES_USER=shelfsense
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_PORT=5432

# Spring Boot Backend
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shelfsense
SPRING_DATASOURCE_USERNAME=shelfsense
SPRING_DATASOURCE_PASSWORD=your_local_postgres_password

# JWT Signing Key (Base64-encoded >= 256-bit key; generate with: openssl rand -base64 32)
SHELF_SENSE_JWT_ISSUER=shelfsense
SHELF_SENSE_JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET_KEY
SHELF_SENSE_JWT_EXPIRATION=PT1H

# CORS (comma-separated allowed frontend origins)
SHELF_SENSE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Administrator Bootstrap (optional, one-time idempotent seed; password >= 12 chars)
SHELF_SENSE_BOOTSTRAP_ADMIN_USERNAME=admin@shelfsense.local
SHELF_SENSE_BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_min12chars

# Python FastAPI ML Service
ML_PORT=8001
SHELF_SENSE_ML_URL=http://localhost:8001
SHELF_SENSE_ML_CONNECT_TIMEOUT_MS=2000
SHELF_SENSE_ML_READ_TIMEOUT_MS=5000

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=

# Optional Kaggle credentials for M5 dataset download via Kaggle CLI
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key
